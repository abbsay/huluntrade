---
import Layout from '../layouts/Layout.astro';

const CONTACT_METHODS = [
  {
    icon: '📱',
    title: 'Direct Phone & WhatsApp',
    desc: 'Available 7 days a week for fast quotation and catalog sharing.',
    value: '+86 13967427888 / 17758069907',
    link: 'https://wa.me/8613967427888'
  },
  {
    icon: '✉️',
    title: 'Official Export Email',
    desc: 'Send your purchase orders and OEM inquiry specifications.',
    value: 'Van001@huluntrade.com',
    link: 'mailto:Van001@huluntrade.com'
  },
  {
    icon: '📍',
    title: 'Export Office & Showroom',
    desc: 'Located in the heart of the world largest commodity trading center.',
    value: 'Yiwu International Trade City, Zhejiang, China',
    link: 'https://maps.google.com/?q=Yiwu,Zhejiang,China'
  }
];
---

<Layout
  title="Contact Us — Hulun Sweets | Wholesale Confectionery & OEM Inquiry"
  description="Contact Hulun Sweets export department. Inquire for wholesale marshmallow, jelly, and hard candy catalogs, container pricing, or OEM private label partnerships."
>
  <div class="pt-36 lg:pt-44 pb-32 bg-cream min-h-screen">
    <div class="max-w-[1300px] mx-auto px-4 md:px-6 xl:px-8">

      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest bg-strawberry/10 text-strawberry mb-4 border border-strawberry/20">
          Get in Touch
        </span>
        <h1 class="text-4xl md:text-6xl font-black font-display text-choco tracking-tight">
          Let's Start Something Sweet Together
        </h1>
        <p class="text-mocha text-lg md:text-xl font-medium mt-4">
          Whether you are an overseas importer, distributor, or brand owner seeking OEM candy manufacturing, our sales representatives are ready to assist.
        </p>
      </div>

      <!-- Quick Contact Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        {CONTACT_METHODS.map((method) => (
          <a
            href={method.link}
            target={method.link.startsWith('http') ? '_blank' : undefined}
            rel={method.link.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="group bg-white p-8 rounded-[2rem] border border-choco/5 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between"
          >
            <div>
              <div class="text-4xl mb-4 group-hover:scale-110 transition-transform origin-left">{method.icon}</div>
              <h3 class="text-xl font-bold font-display text-choco mb-2 group-hover:text-strawberry transition-colors">
                {method.title}
              </h3>
              <p class="text-sm text-mocha/80 leading-relaxed mb-6 font-medium">
                {method.desc}
              </p>
            </div>
            <div class="pt-4 border-t border-choco/5 text-sm font-bold text-choco group-hover:text-strawberry transition-colors truncate">
              {method.value} &rarr;
            </div>
          </a>
        ))}
      </div>

      <!-- Inquiry Form Container -->
      <div class="bg-white rounded-[2.5rem] p-8 sm:p-12 lg:p-16 border border-choco/5 shadow-md max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-black font-display text-choco tracking-tight">
            Send an Export Inquiry
          </h2>
          <p class="text-mocha text-sm sm:text-base mt-2 font-medium">
            Fill out the form below and we will get back to you with wholesale catalogs and pricing within 24 hours.
          </p>
        </div>

        <form id="inquiry-form" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-xs font-bold uppercase tracking-wider text-choco mb-2">
                Your Name *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="e.g. John Doe"
                class="w-full px-5 py-3.5 rounded-2xl bg-cream/50 border border-choco/10 text-choco placeholder:text-mocha/40 focus:outline-none focus:border-strawberry focus:ring-2 focus:ring-strawberry/20 text-sm font-medium transition-all"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-bold uppercase tracking-wider text-choco mb-2">
                Email Address *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="john@example.com"
                class="w-full px-5 py-3.5 rounded-2xl bg-cream/50 border border-choco/10 text-choco placeholder:text-mocha/40 focus:outline-none focus:border-strawberry focus:ring-2 focus:ring-strawberry/20 text-sm font-medium transition-all"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-choco mb-2">
                WhatsApp / Phone Number
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="+1 234 567 8900"
                class="w-full px-5 py-3.5 rounded-2xl bg-cream/50 border border-choco/10 text-choco placeholder:text-mocha/40 focus:outline-none focus:border-strawberry focus:ring-2 focus:ring-strawberry/20 text-sm font-medium transition-all"
              />
            </div>

            <div>
              <label for="country" class="block text-xs font-bold uppercase tracking-wider text-choco mb-2">
                Target Country / Region
              </label>
              <input
                type="text"
                id="country"
                name="country"
                placeholder="e.g. Saudi Arabia, UAE, Russia"
                class="w-full px-5 py-3.5 rounded-2xl bg-cream/50 border border-choco/10 text-choco placeholder:text-mocha/40 focus:outline-none focus:border-strawberry focus:ring-2 focus:ring-strawberry/20 text-sm font-medium transition-all"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-xs font-bold uppercase tracking-wider text-choco mb-2">
              Interested Product / Service
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="e.g. Marshmallow Bulk Order, OEM Custom Label, Wholesale Catalog"
              class="w-full px-5 py-3.5 rounded-2xl bg-cream/50 border border-choco/10 text-choco placeholder:text-mocha/40 focus:outline-none focus:border-strawberry focus:ring-2 focus:ring-strawberry/20 text-sm font-medium transition-all"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-bold uppercase tracking-wider text-choco mb-2">
              Inquiry Details / Estimated Volume *
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Please let us know your requirements, target port, estimated quantities, or custom packaging needs..."
              class="w-full px-5 py-3.5 rounded-2xl bg-cream/50 border border-choco/10 text-choco placeholder:text-mocha/40 focus:outline-none focus:border-strawberry focus:ring-2 focus:ring-strawberry/20 text-sm font-medium transition-all resize-y"
            ></textarea>
          </div>

          <div id="form-feedback" class="hidden p-4 rounded-2xl text-center text-sm font-bold"></div>

          <div class="text-center pt-2">
            <button
              type="submit"
              id="submit-btn"
              class="w-full sm:w-auto px-10 py-4 rounded-full bg-strawberry hover:bg-pink-600 text-white font-bold font-display tracking-wide shadow-lg shadow-strawberry/30 hover:scale-105 transition-all text-base cursor-pointer"
            >
              Send Inquiry Message &rarr;
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>

  <script>
    function setupContactForm() {
      // Pre-fill subject if passed in URL
      const urlParams = new URLSearchParams(window.location.search);
      const subj = urlParams.get('subject');
      const subjectInput = document.getElementById('subject') as HTMLInputElement;
      if (subj && subjectInput) {
        subjectInput.value = subj;
      }

      const form = document.getElementById('inquiry-form') as HTMLFormElement;
      const feedback = document.getElementById('form-feedback') as HTMLDivElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

      if (!form) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.innerText = 'Submitting...';

        const name = (document.getElementById('name') as HTMLInputElement).value;
        const email = (document.getElementById('email') as HTMLInputElement).value;
        const phone = (document.getElementById('phone') as HTMLInputElement).value;
        const subject = subjectInput ? subjectInput.value : '';
        const message = (document.getElementById('message') as HTMLTextAreaElement).value;

        // Construct mailto as instant zero-failure fallback
        const mailSubject = encodeURIComponent(`[Website Inquiry] ${subject || 'New Candy Inquiry'}`);
        const mailBody = encodeURIComponent(
          `Name: ${name}\nEmail: ${email}\nPhone: ${phone}\n\nMessage:\n${message}`
        );

        // Show celebratory feedback
        feedback.className = 'p-4 rounded-2xl text-center text-sm font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 block';
        feedback.innerText = 'Thank you! Preparing your direct inquiry mail draft...';

        setTimeout(() => {
          window.location.href = `mailto:Van001@huluntrade.com?subject=${mailSubject}&body=${mailBody}`;
          submitBtn.disabled = false;
          submitBtn.innerText = 'Send Inquiry Message →';
        }, 600);
      });
    }

    setupContactForm();
    document.addEventListener('astro:page-load', setupContactForm);
  </script>
</Layout>
