---
import Layout from '../layouts/Layout.astro';

const MILESTONES = [
  { year: '2012', title: 'Confectionery Inception', desc: 'Established specialized candy manufacturing and export operations in Yiwu.' },
  { year: '2016', title: 'Halal & Clean-room Upgrade', desc: 'Achieved international Halal certification and modernized dust-free automated lines.' },
  { year: '2020', title: 'Global OEM Network', desc: 'Expanded custom private label processing for Middle East and European supermarket chains.' },
  { year: '2026', title: 'Digital Trade & Innovation', desc: 'Serving 40+ countries with advanced rapid sampling and container logistics fulfillment.' }
];

const VALUES = [
  {
    icon: '🍬',
    title: 'Pure Flavor & Texture',
    desc: 'Using high-purity gelatin, pectin, and natural extracts for soft, clean, and delightful mouthfeel.'
  },
  {
    icon: '🛡️',
    title: 'Food Safety Assured',
    desc: 'Stringent laboratory testing for microbial counts, heavy metals, and ingredient authenticity.'
  },
  {
    icon: '🤝',
    title: 'Long-term Partnership',
    desc: 'Transparent pricing, dependable delivery schedules, and dedicated account managers for every buyer.'
  },
  {
    icon: '💡',
    title: 'Creative R&D Design',
    desc: 'Regularly releasing eye-catching packaging shapes and kid-friendly novelty themes.'
  }
];
---

<Layout
  title="About Us — Hulun Sweets | Confectionery Factory & Global Exporter"
  description="Discover Hulun Sweets: our factory capabilities, Halal-certified clean room production, and dedication to crafting high quality candies for overseas markets."
>
  <div class="pt-36 lg:pt-44 pb-32 bg-cream min-h-screen">
    <div class="max-w-[1300px] mx-auto px-4 md:px-6 xl:px-8">

      <!-- Hero Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest bg-strawberry/10 text-strawberry mb-4 border border-strawberry/20">
          Factory Profile
        </span>
        <h1 class="text-4xl md:text-6xl font-black font-display text-choco tracking-tight">
          Bringing Sweet Joy to Every Corner of the Globe
        </h1>
        <p class="text-mocha text-lg md:text-xl font-medium mt-6 leading-relaxed">
          Headquartered in the global trading hub of Yiwu, Zhejiang, Hulun Sweets combines modern automated confectionery lines with authentic taste and strict export compliance.
        </p>
      </div>

      <!-- Factory Overview Split Card -->
      <div class="bg-white rounded-[2.5rem] p-8 md:p-14 border border-choco/5 shadow-sm mb-20 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-strawberry mb-2 block">
            Quality First Confectionery
          </span>
          <h2 class="text-3xl md:text-4xl font-black font-display text-choco mb-6 leading-tight">
            Certified Excellence from Raw Materials to Finished Packages
          </h2>
          <div class="space-y-4 text-mocha text-base md:text-lg leading-relaxed font-medium">
            <p>
              At Hulun Sweets, we believe candy is more than just sugar—it is a universal language of celebration, warmth, and childhood smiles.
            </p>
            <p>
              Our manufacturing facilities feature modern temperature-controlled molding, extrusion lines for multi-colored marshmallows, and automated flow-wrapping systems that ensure long shelf-life and pristine hygiene across transit.
            </p>
            <p>
              With comprehensive Halal verification and strict adherence to international export standards, our products are welcomed on retail shelves across Dubai, Riyadh, Moscow, Paris, and beyond.
            </p>
          </div>
        </div>

        <div class="bg-gradient-to-tr from-pink-100/50 via-cream to-amber-100/40 rounded-3xl p-8 sm:p-12 border border-choco/5 flex flex-col justify-center">
          <h3 class="text-xl font-black font-display text-choco mb-6">Our Factory Highlights</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-4">
              <span class="w-8 h-8 rounded-full bg-strawberry text-white flex items-center justify-center font-bold text-sm flex-shrink-0">✓</span>
              <div>
                <strong class="text-choco font-bold">Automated Production Lines:</strong>
                <p class="text-sm text-mocha mt-0.5">High-capacity extrusion & molding ensuring batch-to-batch consistency.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="w-8 h-8 rounded-full bg-strawberry text-white flex items-center justify-center font-bold text-sm flex-shrink-0">✓</span>
              <div>
                <strong class="text-choco font-bold">100% Halal Compliant:</strong>
                <p class="text-sm text-mocha mt-0.5">Strict raw material auditing guaranteeing pork-free and alcohol-free recipes.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="w-8 h-8 rounded-full bg-strawberry text-white flex items-center justify-center font-bold text-sm flex-shrink-0">✓</span>
              <div>
                <strong class="text-choco font-bold">Custom OEM Packaging:</strong>
                <p class="text-sm text-mocha mt-0.5">Flexible carton sizing, retail display boxes, and multi-lingual barcoding.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <!-- Core Values -->
      <div class="mb-20">
        <h2 class="text-3xl font-black font-display text-choco text-center mb-12">
          Our Core Manufacturing Commitments
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {VALUES.map((val) => (
            <div class="bg-white p-8 rounded-3xl border border-choco/5 shadow-sm flex flex-col">
              <div class="text-4xl mb-4">{val.icon}</div>
              <h3 class="text-xl font-bold font-display text-choco mb-2">{val.title}</h3>
              <p class="text-mocha text-sm leading-relaxed">{val.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Growth Milestones -->
      <div class="bg-white rounded-[2.5rem] p-8 md:p-14 border border-choco/5 shadow-sm">
        <h2 class="text-3xl font-black font-display text-choco text-center mb-12">
          Our Growth & Export Journey
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          {MILESTONES.map((m) => (
            <div class="relative pl-6 md:pl-0 border-l-2 md:border-l-0 md:border-t-2 border-strawberry/30 pt-4">
              <span class="text-2xl font-black font-display text-strawberry block mb-1">
                {m.year}
              </span>
              <h4 class="text-lg font-bold font-display text-choco mb-2">
                {m.title}
              </h4>
              <p class="text-sm text-mocha leading-relaxed">
                {m.desc}
              </p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</Layout>
