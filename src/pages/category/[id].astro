---
import Layout from '../../layouts/Layout.astro';
import { mockProducts } from '../../data/mockProducts';

export async function getStaticPaths() {
  const categories = [
    {
      id: 'marshmallow',
      name: 'Marshmallow',
      title: 'Delicious Marshmallows — Hulun Sweets',
      desc: 'Discover our soft, fluffy, and cloud-like marshmallows. Fun shapes, fruity swirl twists, and creative themes exported globally.',
      img: '/images/categories/minimal_marshmallow.svg'
    },
    {
      id: 'jelly',
      name: 'Jelly Candy',
      title: 'Juicy Jelly Candies — Hulun Sweets',
      desc: 'Explore our collection of juicy and chewy jelly gummies. Packed with fruit flavors and crystal clarity.',
      img: '/images/categories/minimal_jelly.svg'
    },
    {
      id: 'hard_candy',
      name: 'Hard Candy & Lollipops',
      title: 'Hard Candies & Lollipops — Hulun Sweets',
      desc: 'Classic handmade hard candies, artistic crystal swirls, and colorful lollipops made for enduring sweet joy.',
      img: '/images/categories/minimal_hard_candy.svg'
    },
    {
      id: 'candy_toy',
      name: 'Candy Toys & Novelty',
      title: 'Playful Candy Toys — Hulun Sweets',
      desc: 'Creative interactive candy toys combining tasty sweets with hours of engaging play for kids.',
      img: '/images/categories/minimal_toy.svg'
    },
  ];

  return categories.map((cat) => ({
    params: { id: cat.id },
    props: {
      category: cat,
      products: mockProducts.filter((p) => p.categoryId === cat.id),
    },
  }));
}

const { category, products } = Astro.props;
---

<Layout
  title={category.title}
  description={category.desc}
>
  <div class="pt-36 lg:pt-44 pb-32 bg-cream min-h-screen">
    <div class="max-w-[1400px] mx-auto px-4 md:px-6 xl:px-8">

      <!-- Breadcrumbs -->
      <nav class="mb-8 flex items-center gap-2 text-xs font-bold text-mocha/70">
        <a href="/" class="hover:text-strawberry transition-colors">Home</a>
        <span>/</span>
        <a href="/products" class="hover:text-strawberry transition-colors">Categories</a>
        <span>/</span>
        <span class="text-choco font-black">{category.name}</span>
      </nav>

      <!-- Category Hero Header -->
      <div class="bg-white rounded-[2.5rem] p-8 md:p-14 border border-choco/5 shadow-sm mb-16 flex flex-col md:flex-row items-center gap-8 md:gap-12">
        <div class="w-32 h-32 md:w-40 md:h-40 flex-shrink-0 bg-cream/70 rounded-full p-6 border border-choco/5 flex items-center justify-center filter drop-shadow-sm">
          <img
            src={category.img}
            alt={category.name}
            class="w-full h-full object-contain"
          />
        </div>
        <div class="text-center md:text-left flex-1">
          <span class="inline-block px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-strawberry/10 text-strawberry mb-3">
            {products.length} Products in Collection
          </span>
          <h1 class="text-3xl md:text-5xl font-black font-display text-choco tracking-tight mb-3">
            {category.name}
          </h1>
          <p class="text-mocha text-base md:text-lg leading-relaxed max-w-2xl">
            {category.desc}
          </p>
        </div>
      </div>

      <!-- Products Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
        {products.map((product) => (
          <div class="group flex flex-col bg-white rounded-[2rem] border border-choco/5 shadow-[0_10px_30px_rgba(61,44,35,0.04)] hover:shadow-[0_20px_45px_rgba(255,107,157,0.18)] hover:-translate-y-2 transition-all duration-300 overflow-hidden">
            <a href={`/product/${product.id}`} class="flex flex-col flex-1">
              <div class="relative aspect-square w-full bg-gradient-to-b from-[#FFF8F8] to-white p-6 flex items-center justify-center overflow-hidden">
                <img
                  src={product.image}
                  alt={product.name}
                  class="w-full h-full object-contain filter drop-shadow-md group-hover:scale-110 transition-transform duration-500"
                  loading="lazy"
                />
              </div>

              <div class="flex flex-col flex-1 p-5 justify-between bg-white">
                <h3 class="text-base sm:text-lg font-bold font-display text-choco group-hover:text-strawberry transition-colors line-clamp-2 leading-snug">
                  {product.name}
                </h3>

                <div class="mt-4 pt-3 border-t border-choco/5 flex flex-wrap items-center justify-between gap-2 text-xs font-semibold text-mocha">
                  <span>⚖️ {product.weight || '35g'}</span>
                  <span class="text-mocha/70">📦 {product.packaging || 'Box'}</span>
                </div>
              </div>
            </a>

            <div class="px-5 pb-5 pt-0 bg-white">
              <a
                href={`/product/${product.id}`}
                class="w-full py-2.5 rounded-full bg-cream hover:bg-strawberry hover:text-white text-choco font-bold text-xs flex items-center justify-center gap-1 transition-colors"
              >
                View Specifications &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</Layout>
