---
import ProductDetailPage from '../../components/pages/ProductDetailPage.astro';
import { mockProducts } from '../../data/mockProducts';

export async function getStaticPaths() {
  return mockProducts.map((p) => ({
    params: { id: p.id },
    props: { product: p },
  }));
}

const { product } = Astro.props;
---

<ProductDetailPage product={product} lang="en" />
