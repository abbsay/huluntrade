---
import ProductsPage from '../../components/pages/ProductsPage.astro';

export function getStaticPaths() {
  return [
    { params: { locale: 'ar' } },
    { params: { locale: 'ru' } },
    { params: { locale: 'fr' } },
  ];
}

const { locale } = Astro.params;
---

<ProductsPage lang={locale} />
