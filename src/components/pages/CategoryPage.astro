---
import Layout from '../../layouts/Layout.astro';
import CategoryContent from '../CategoryContent';
import { CATEGORIES_I18N } from '../../data/categories';

interface Props {
  category: {
    id: string;
    name: string;
    title: string;
    desc: string;
    img: string;
  };
  products: any[];
  lang?: string;
}

const { category, products, lang = 'en' } = Astro.props;

const dict = CATEGORIES_I18N[lang]?.[category.id] || CATEGORIES_I18N.en[category.id];
const catName = dict?.name || category.name;
const catTitle = dict?.title || category.title;
const catDesc = dict?.desc || category.desc;
---

<Layout
  title={catTitle}
  description={catDesc}
  lang={lang}
>
  <CategoryContent
    client:load
    categoryId={category.id}
    categoryName={catName}
    categoryDesc={catDesc}
    products={products}
    currentLang={lang}
  />
</Layout>
