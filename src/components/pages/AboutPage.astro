---
import Layout from '../../layouts/Layout.astro';
import AboutContent from '../AboutContent';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const pageTitle = lang === 'ar' ? 'من نحن — حلويات هولون | مصنع التصدير وحكاية العلامة التجارية' :
                  lang === 'ru' ? 'О нас — Hulun Sweets | История и производство' :
                  lang === 'fr' ? 'À propos — Hulun Sweets | Notre histoire et savoir-faire' :
                  'About Us — Hulun Sweets | Confectionery Factory & Brand Story';

const pageDesc = lang === 'ar' ? 'تعرف على قصة حلويات هولون في إيوو، الصين: التزامنا بالنقاء والمذاق اللذيذ والمعايير العالمية وشهادة حلال.' :
                 lang === 'ru' ? 'История кондитерской фабрики Hulun Sweets в Иу, Китай: приверженность качеству, чистоте вкуса и международным стандартам.' :
                 lang === 'fr' ? 'Découvrez l’histoire de Hulun Sweets à Yiwu, Chine: notre engagement envers la qualité, le goût authentique et les normes Halal.' :
                 'Discover the story of Hulun Sweets in Yiwu, China: our dedication to taste, certified food safety, and joyful confectionery for world markets.';
---

<Layout
  title={pageTitle}
  description={pageDesc}
  lang={lang}
>
  <!-- Restored 100% Original TanStack Editorial Typography & Smoke Parallax -->
  <AboutContent client:load currentLang={lang} />
</Layout>
