---
import Layout from '../../layouts/Layout.astro';
import HeroSlider from '../HeroSlider';
import ProductGrid from '../ProductGrid';
import { useTranslatedPath } from '../../i18n';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const CATEGORIES_DATA: Record<string, Array<{
  id: string;
  name: string;
  tagline: string;
  desc: string;
  badge: string;
  img: string;
  gradient: string;
  border: string;
}>> = {
  en: [
    {
      id: 'marshmallow',
      name: 'Marshmallow',
      tagline: 'Lighter than air',
      desc: 'Fluffy, cloud-like textures in fun shapes, swirl twists, and creative themes.',
      img: '/images/categories/minimal_marshmallow.svg',
      badge: 'Hot Seller',
      gradient: 'from-pink-500/10 via-pink-400/5 to-transparent',
      border: 'hover:border-pink-300'
    },
    {
      id: 'jelly',
      name: 'Jelly Candy',
      tagline: 'Bursting fruit flavor',
      desc: 'Juicy, chewy, and crystal-clear gummies made with real fruit extract.',
      img: '/images/categories/minimal_jelly.svg',
      badge: 'Rich Fruit',
      gradient: 'from-amber-500/10 via-amber-400/5 to-transparent',
      border: 'hover:border-amber-300'
    },
    {
      id: 'hard_candy',
      name: 'Hard Candy',
      tagline: 'Enduring sweet crunch',
      desc: 'Artisanal lollipop swirls, crystal hard candies, and nostalgic treats.',
      img: '/images/categories/minimal_hard_candy.svg',
      badge: 'Classic',
      gradient: 'from-purple-500/10 via-purple-400/5 to-transparent',
      border: 'hover:border-purple-300'
    },
    {
      id: 'candy_toy',
      name: 'Candy Toys',
      tagline: 'Play meets taste',
      desc: 'Interactive novelty toys paired with delicious sweets for children everywhere.',
      img: '/images/categories/minimal_toy.svg',
      badge: 'Novelty Fun',
      gradient: 'from-sky-500/10 via-sky-400/5 to-transparent',
      border: 'hover:border-sky-300'
    },
  ],
  ar: [
    {
      id: 'marshmallow',
      name: 'مارشميلو',
      tagline: 'أخف من الهواء',
      desc: 'قوام طري يشبه السحاب بأشكال مرحة وحلزونية ونكهات مميزة للأطفال والعائلات.',
      img: '/images/categories/minimal_marshmallow.svg',
      badge: 'الأكثر مبيعاً',
      gradient: 'from-pink-500/10 via-pink-400/5 to-transparent',
      border: 'hover:border-pink-300'
    },
    {
      id: 'jelly',
      name: 'حلوى الجيلي',
      tagline: 'انفجار نكهات الفواكه',
      desc: 'حلوى جيلي طرية وشهية ومصنوعة بخلاصات الفواكه الطبيعية النقية.',
      img: '/images/categories/minimal_jelly.svg',
      badge: 'فواكه طبيعية',
      gradient: 'from-amber-500/10 via-amber-400/5 to-transparent',
      border: 'hover:border-amber-300'
    },
    {
      id: 'hard_candy',
      name: 'حلوى صلبة ومصاصات',
      tagline: 'قرمشة وحلاوة تدوم',
      desc: 'مصاصات فنية بألوان ساحرة وحلوى صلبة كريستالية مصنوعة يدويًا بدقة.',
      img: '/images/categories/minimal_hard_candy.svg',
      badge: 'كلاسيكي',
      gradient: 'from-purple-500/10 via-purple-400/5 to-transparent',
      border: 'hover:border-purple-300'
    },
    {
      id: 'candy_toy',
      name: 'ألعاب الحلوى',
      tagline: 'متعة اللعب ولذة المذاق',
      desc: 'ألعاب مبتكرة تفاعلية مدمجة بحلويات شهية ومفرحة للأطفال حول العالم.',
      img: '/images/categories/minimal_toy.svg',
      badge: 'ألعاب ممتعة',
      gradient: 'from-sky-500/10 via-sky-400/5 to-transparent',
      border: 'hover:border-sky-300'
    },
  ],
  ru: [
    {
      id: 'marshmallow',
      name: 'Маршмеллоу',
      tagline: 'Легче воздуха',
      desc: 'Нежная облачная текстура, оригинальные спирали и яркие вкусы для всей семьи.',
      img: '/images/categories/minimal_marshmallow.svg',
      badge: 'Хит продаж',
      gradient: 'from-pink-500/10 via-pink-400/5 to-transparent',
      border: 'hover:border-pink-300'
    },
    {
      id: 'jelly',
      name: 'Желейные конфеты',
      tagline: 'Сочный фруктовый вкус',
      desc: 'Жевательный мармелад и прозрачные желейные конфеты из натурального сока.',
      img: '/images/categories/minimal_jelly.svg',
      badge: 'Натур. сок',
      gradient: 'from-amber-500/10 via-amber-400/5 to-transparent',
      border: 'hover:border-amber-300'
    },
    {
      id: 'hard_candy',
      name: 'Карамель и леденцы',
      tagline: 'Долгая сладость и хруст',
      desc: 'Артизанальные леденцы на палочке и классическая хрустящая карамель.',
      img: '/images/categories/minimal_hard_candy.svg',
      badge: 'Классика',
      gradient: 'from-purple-500/10 via-purple-400/5 to-transparent',
      border: 'hover:border-purple-300'
    },
    {
      id: 'candy_toy',
      name: 'Конфеты-игрушки',
      tagline: 'Игра и вкус вместе',
      desc: 'Интерактивные игрушки с вкусным сладким наполнением для радости детей.',
      img: '/images/categories/minimal_toy.svg',
      badge: 'Новинки',
      gradient: 'from-sky-500/10 via-sky-400/5 to-transparent',
      border: 'hover:border-sky-300'
    },
  ],
  fr: [
    {
      id: 'marshmallow',
      name: 'Guimauve',
      tagline: 'Plus léger que l’air',
      desc: 'Textures moelleuses et aériennes aux formes amusantes et torsades fruitées.',
      img: '/images/categories/minimal_marshmallow.svg',
      badge: 'Top Vente',
      gradient: 'from-pink-500/10 via-pink-400/5 to-transparent',
      border: 'hover:border-pink-300'
    },
    {
      id: 'jelly',
      name: 'Bonbons Gélifiés',
      tagline: 'Explosion fruitée',
      desc: 'Gummies juteux, tendres et translucides élaborés avec des extraits naturels de fruits.',
      img: '/images/categories/minimal_jelly.svg',
      badge: 'Pur Fruit',
      gradient: 'from-amber-500/10 via-amber-400/5 to-transparent',
      border: 'hover:border-amber-300'
    },
    {
      id: 'hard_candy',
      name: 'Sucettes & Bonbons Durs',
      tagline: 'Croquant et douceur durable',
      desc: 'Sucettes artisanales torsadées et bonbons durs traditionnels aux saveurs intemporelles.',
      img: '/images/categories/minimal_hard_candy.svg',
      badge: 'Classique',
      gradient: 'from-purple-500/10 via-purple-400/5 to-transparent',
      border: 'hover:border-purple-300'
    },
    {
      id: 'candy_toy',
      name: 'Jouets de Bonbons',
      tagline: 'Le jeu rencontre la gourmandise',
      desc: 'Jouets interactifs novateurs accompagnés de confiseries savoureuses pour les enfants.',
      img: '/images/categories/minimal_toy.svg',
      badge: 'Amusement',
      gradient: 'from-sky-500/10 via-sky-400/5 to-transparent',
      border: 'hover:border-sky-300'
    },
  ]
};

const ADVANTAGES_DATA: Record<string, Array<{ icon: string; title: string; desc: string }>> = {
  en: [
    {
      icon: '🌍',
      title: 'Global Export to 40+ Nations',
      desc: 'Trusted by supermarket chains, importers, and candy distributors across the Middle East, Central Asia, Southeast Asia, and Europe.'
    },
    {
      icon: '✨',
      title: 'Halal & HACCP Certified',
      desc: 'Produced under strict clean-room international food safety protocols with complete Halal-compliant ingredients and traceability.'
    },
    {
      icon: '🎨',
      title: 'OEM / ODM Custom Processing',
      desc: 'Full private label services from custom recipe formulations, shapes, and color matching to multi-language retail packaging.'
    },
    {
      icon: '⚡',
      title: 'Factory-Direct Pricing & Supply',
      desc: 'Based in the Yiwu international trade center with rapid container shipping and flexible MOQ for overseas buyers.'
    }
  ],
  ar: [
    {
      icon: '🌍',
      title: 'تصدير عالمي لأكثر من 40 دولة',
      desc: 'موثوق من سلاسل السوبرماركت والمستوردين وموزعي الحلويات في الشرق الأوسط وآسيا الوسطى وأوروبا.'
    },
    {
      icon: '✨',
      title: 'شهادات حلال و HACCP المعتمدة',
      desc: 'يتم الإنتاج وفق أعلى معايير سلامة الأغذية العالمية في غرف معقمة وبمكونات حلال 100% مع التتبع الكامل.'
    },
    {
      icon: '🎨',
      title: 'تصنيع مخصص OEM / ODM',
      desc: 'خدمات العلامة التجارية الخاصة الكاملة: وصفات مخصصة، أشكال مبتكرة، وتغليف تجزئة متعدد اللغات.'
    },
    {
      icon: '⚡',
      title: 'أسعار المصنع المباشرة وتوريد سريع',
      desc: 'مقرنا في مدينة إيوو للتجارة الدولية مع شحن حاويات سريع وحد أدنى مرن للطلبات الخارجية.'
    }
  ],
  ru: [
    {
      icon: '🌍',
      title: 'Экспорт в более чем 40 стран',
      desc: 'Нам доверяют торговые сети, оптовики и дистрибьюторы Ближнего Востока, СНГ, Европы и Азии.'
    },
    {
      icon: '✨',
      title: 'Сертификация Халяль и HACCP',
      desc: 'Производство в чистых помещениях по международным стандартам безопасности с полной прослеживаемостью.'
    },
    {
      icon: '🎨',
      title: 'Контрактное производство OEM / ODM',
      desc: 'Разработка под вашей торговой маркой: индивидуальная рецептура, формы, фасовка и мультиязычная упаковка.'
    },
    {
      icon: '⚡',
      title: 'Прямые цены от производителя',
      desc: 'Базирование в международном торговом хабе Иу с оперативной отгрузкой контейнеров и гибким MOQ.'
    }
  ],
  fr: [
    {
      icon: '🌍',
      title: 'Exportation vers 40+ pays',
      desc: 'Partenaire de confiance des supermarchés, importateurs et distributeurs au Moyen-Orient, en Europe et en Asie.'
    },
    {
      icon: '✨',
      title: 'Certifié Halal & HACCP',
      desc: 'Fabriqué selon des normes internationales d’hygiène strictes en salle blanche avec ingrédients 100% Halal.'
    },
    {
      icon: '🎨',
      title: 'Fabrication sur mesure OEM / ODM',
      desc: 'Services complets de marque blanche: formules sur mesure, formes personnalisées et emballages multilingues.'
    },
    {
      icon: '⚡',
      title: 'Prix direct d’usine & Réactivité',
      desc: 'Implanté au centre international d’échanges de Yiwu avec expédition rapide par conteneurs et MOQ flexible.'
    }
  ]
};

const categories = CATEGORIES_DATA[lang] || CATEGORIES_DATA['en'];
const advantages = ADVANTAGES_DATA[lang] || ADVANTAGES_DATA['en'];

const pageTitle = lang === 'ar' ? 'حلويات هولون — مصنع ومصدر للحلويات بالجملة | إيوو، الصين' :
                  lang === 'ru' ? 'Hulun Sweets — Оптовый производитель и экспортер кондитерских изделий | Иу, Китай' :
                  lang === 'fr' ? 'Hulun Sweets — Fabricant et exportateur de confiseries en gros | Yiwu, Chine' :
                  'Hulun Sweets — Wholesale Candy & Confectionery Manufacturer | Yiwu, China';

const pageDesc = lang === 'ar' ? 'اكتشف حلويات هولون: مارشميلو بالجملة، حلوى الجيلي، مصاصات، وحلويات ألعاب ممتعة. جودة ممتازة، شهادة حلال، وتصنيع OEM وتصدير عالمي.' :
                 lang === 'ru' ? 'Кондитерские изделия оптом от Hulun Sweets: нежный маршмеллоу, желейные конфеты, карамель и конфеты-игрушки. Сертификат Халяль, прямой экспорт из Иу.' :
                 lang === 'fr' ? 'Découvrez Hulun Sweets: guimauves en gros, bonbons gélifiés, sucettes et jouets sucrés. Qualité supérieure, certifié Halal, fabrication OEM pour l’export.' :
                 'Explore Hulun Sweets: wholesale marshmallows, fruit jellies, hard candies, and candy toys. Premium quality, Halal certified, and global OEM export.';
---

<Layout
  title={pageTitle}
  description={pageDesc}
  lang={lang}
>
  <!-- 1. FULL SCREEN HERO SLIDER -->
  <HeroSlider client:load currentLang={lang} />

  <!-- 2. CATEGORY SPOTLIGHT SECTION -->
  <section class="py-20 md:py-28 bg-cream relative overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-4 md:px-6 xl:px-8">

      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest bg-strawberry/10 text-strawberry mb-4 border border-strawberry/20">
          {lang === 'ar' ? 'عالمنا الحلو' : lang === 'ru' ? 'Сладкий мир Hulun' : lang === 'fr' ? 'Notre Univers Gourmand' : 'Our Sweet Universe'}
        </span>
        <h2 class="text-4xl md:text-5xl font-black font-display text-choco tracking-tight">
          {lang === 'ar' ? 'صُنعت لتزرع الابتسامة حول العالم' : lang === 'ru' ? 'Дарим сладкие улыбки по всему миру' : lang === 'fr' ? 'Conçu pour apporter des sourires dans le monde entier' : 'Crafted to Bring Smiles Worldwide'}
        </h2>
        <p class="text-mocha text-lg md:text-xl font-medium mt-4">
          {lang === 'ar' ? 'اكتشف خطوط إنتاجنا الأربعة المتميزة، المطورة بعناية لأسواق البيع بالتجزئة والجملة العالمية.' :
           lang === 'ru' ? 'Откройте для себя четыре фирменные линейки сладостей, созданные для розничных сетей и международных оптовиков.' :
           lang === 'fr' ? 'Découvrez nos quatre gammes de confiseries signatures, méticuleusement élaborées pour la distribution internationale.' :
           'Discover our four signature confectionery lines, meticulously developed for overseas retail and wholesale markets.'}
        </p>
      </div>

      <!-- Category Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {categories.map((cat) => (
          <a
            href={translatePath(`/category/${cat.id}`)}
            class={`group relative bg-white rounded-[2.5rem] p-8 border border-choco/5 shadow-[0_15px_35px_rgba(61,44,35,0.05)] hover:shadow-[0_25px_50px_rgba(255,107,157,0.15)] transition-all duration-500 hover:-translate-y-2 flex flex-col justify-between overflow-hidden ${cat.border}`}
          >
            <!-- Ambient Glow -->
            <div class={`absolute top-0 right-0 rtl:right-auto rtl:left-0 w-44 h-44 bg-gradient-to-bl ${cat.gradient} rounded-full blur-2xl group-hover:scale-150 transition-transform duration-700 pointer-events-none`} />

            <div>
              <div class="flex items-center justify-between mb-6">
                <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-cream text-choco/80 border border-choco/5">
                  {cat.badge}
                </span>
                <span class="text-strawberry opacity-0 group-hover:opacity-100 transition-opacity duration-300 font-bold text-sm flex items-center gap-1">
                  {lang === 'ar' ? 'استكشف ←' : lang === 'ru' ? 'Подробнее →' : lang === 'fr' ? 'Explorer →' : 'Explore →'}
                </span>
              </div>

              <div class="w-24 h-24 mx-auto mb-6 relative group-hover:scale-110 group-hover:rotate-6 transition-transform duration-500">
                <img
                  src={cat.img}
                  alt={cat.name}
                  class="w-full h-full object-contain filter drop-shadow-md"
                  loading="lazy"
                />
              </div>

              <h3 class="text-2xl font-black font-display text-choco text-center mb-1 group-hover:text-strawberry transition-colors">
                {cat.name}
              </h3>
              <p class="text-xs font-bold text-strawberry uppercase tracking-wider text-center mb-3">
                {cat.tagline}
              </p>
              <p class="text-mocha/80 text-sm leading-relaxed text-center">
                {cat.desc}
              </p>
            </div>

            <div class="mt-8 pt-4 border-t border-choco/5 flex items-center justify-center">
              <span class="text-xs font-bold text-choco/70 group-hover:text-strawberry transition-colors">
                {lang === 'ar' ? 'تصفح تشكيلة الكتالوج' : lang === 'ru' ? 'Смотреть коллекцию' : lang === 'fr' ? 'Voir la collection' : 'View Catalog Collection'}
              </span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- 3. FEATURED CANDY CATALOG -->
  <ProductGrid client:visible currentLang={lang} />

  <!-- 4. B2B EXPORT ADVANTAGES -->
  <section class="py-24 bg-white relative overflow-hidden border-t border-b border-choco/5">
    <div class="max-w-[1300px] mx-auto px-4 md:px-6 xl:px-8">

      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest bg-amber-500/10 text-amber-700 mb-4 border border-amber-500/20">
          {lang === 'ar' ? 'لماذا تختارنا' : lang === 'ru' ? 'Почему мы' : lang === 'fr' ? 'Pourquoi nous choisir' : 'Why Partner With Us'}
        </span>
        <h2 class="text-3xl md:text-5xl font-black font-display text-choco tracking-tight">
          {lang === 'ar' ? 'شريكك الموثوق لتصنيع وتوريد الحلويات' : lang === 'ru' ? 'Ваш надежный партнер в кондитерском бизнесе' : lang === 'fr' ? 'Votre partenaire de confiance pour la confiserie' : 'Your Reliable Confectionery Manufacturing Partner'}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {advantages.map((adv) => (
          <div class="bg-cream/60 rounded-3xl p-8 border border-choco/5 hover:bg-cream transition-colors duration-300">
            <div class="text-4xl mb-5">{adv.icon}</div>
            <h3 class="text-xl font-bold font-display text-choco mb-3">
              {adv.title}
            </h3>
            <p class="text-mocha text-sm leading-relaxed font-medium">
              {adv.desc}
            </p>
          </div>
        ))}
      </div>

      <!-- Factory Trust Metrics -->
      <div class="mt-16 bg-gradient-to-r from-choco to-[#261A13] text-white rounded-[2.5rem] p-8 md:p-12 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="max-w-xl text-center md:text-start">
          <h3 class="text-2xl md:text-3xl font-black font-display mb-3">
            {lang === 'ar' ? 'هل أنت مستعد لتطوير تجارة الحلويات الخاصة بك؟' :
             lang === 'ru' ? 'Готовы расширить свой кондитерский бизнес?' :
             lang === 'fr' ? 'Prêt à développer votre activité de confiserie ?' :
             'Ready to Expand Your Candy Business?'}
          </h3>
          <p class="text-white/80 text-base leading-relaxed font-medium">
            {lang === 'ar' ? 'تواصل مع خبراء التصدير لدينا اليوم للحصول على عينات، وكتالوجات الجملة، وعروض أسعار منافسة للحاويات.' :
             lang === 'ru' ? 'Свяжитесь с нашими специалистами по экспорту для получения образцов, оптового каталога и расчета цен на контейнеры.' :
             lang === 'fr' ? 'Contactez nos spécialistes export dès aujourd’hui pour obtenir des kits d’échantillons, des catalogues et des devis compétitifs.' :
             'Contact our export specialists today for sample kits, wholesale catalogs, and competitive container quotation.'}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-4 justify-center md:justify-start">
          <a
            href={translatePath('/contact')}
            class="px-8 py-4 rounded-full bg-strawberry text-white font-bold font-display tracking-wide hover:scale-105 transition-transform shadow-lg shadow-strawberry/30 text-base"
          >
            {lang === 'ar' ? 'طلب عرض أسعار الحاوية ←' : lang === 'ru' ? 'Запросить расчет цен →' : lang === 'fr' ? 'Demander un devis →' : 'Inquire for Quotation →'}
          </a>
          <a
            href="https://wa.me/8613967427888"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-4 rounded-full bg-white/10 hover:bg-white/20 text-white font-bold text-sm transition-colors border border-white/10"
          >
            {lang === 'ar' ? 'واتساب مباشر 💬' : lang === 'ru' ? 'Прямой WhatsApp 💬' : lang === 'fr' ? 'WhatsApp Direct 💬' : 'WhatsApp Direct 💬'}
          </a>
        </div>
      </div>

    </div>
  </section>

</Layout>
