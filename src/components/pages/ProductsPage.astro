---
import Layout from '../../layouts/Layout.astro';
import { mockProducts } from '../../data/mockProducts';
import { useTranslatedPath } from '../../i18n';
import { getCategoriesWithLocale, ALL_TAB_NAMES } from '../../data/categories';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const categories = getCategoriesWithLocale(lang);
const allTabName = ALL_TAB_NAMES[lang] || ALL_TAB_NAMES.en;

const filterTabs = [
  { id: 'all', name: allTabName },
  ...categories.map((c) => ({ id: c.id, name: c.catalogName })),
];

const categoryNamesMap = Object.fromEntries(
  categories.map((c) => [c.id, c.name])
);

const pageTitle = lang === 'ar' ? 'كتالوج المنتجات الكامل — حلويات هولون | مارشميلو، جيلي، وحلويات بالجملة' :
                  lang === 'ru' ? 'Полный каталог продукции — Hulun Sweets | Маршмеллоу, мармелад, леденцы оптом' :
                  lang === 'fr' ? 'Catalogue complet des produits — Hulun Sweets | Guimauves, gélifiés et bonbons en gros' :
                  'Full Product Catalog — Hulun Sweets | Wholesale Marshmallows, Jellies & Candy';

const pageDesc = lang === 'ar' ? 'تصفح مجموعتنا الكاملة المكونة من أكثر من 50 صنفاً من الحلويات المخصصة للتصدير: مارشميلو طري، حلوى جيلي، ألعاب حلوى إبداعية ومصاصات يدوية الصنع.' :
                 lang === 'ru' ? 'Полная коллекция из более чем 50 сортов экспортных кондитерских изделий: нежный маршмеллоу, желейный мармелад, конфеты-игрушки и леденцы.' :
                 lang === 'fr' ? 'Découvrez notre collection de plus de 50 variétés de confiseries d’exportation: guimauves torsadées, bonbons gélifiés, jouets et sucettes artisanales.' :
                 'Browse our complete collection of over 50+ export-grade candies: soft twist marshmallows, fruit jellies, creative candy toys, and handcrafted lollipops.';
---

<Layout
  title={pageTitle}
  description={pageDesc}
  lang={lang}
>
  <div class="pt-36 lg:pt-44 pb-32 bg-cream min-h-screen">
    <div class="max-w-[1400px] mx-auto px-4 md:px-6 xl:px-8">

      <!-- Catalog Header -->
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest bg-strawberry/10 text-strawberry mb-4 border border-strawberry/20">
          {lang === 'ar' ? 'المجموعة الكاملة' : lang === 'ru' ? 'Полная коллекция' : lang === 'fr' ? 'Collection Complète' : 'Complete Collection'}
        </span>
        <h1 class="text-4xl md:text-6xl font-black font-display text-choco tracking-tight">
          {lang === 'ar' ? 'استكشف كتالوج حلوياتنا اللذيذة' : lang === 'ru' ? 'Каталог кондитерских изделий' : lang === 'fr' ? 'Explorez Notre Catalogue Gourmand' : 'Explore Our Sweet Catalog'}
        </h1>
        <p class="text-mocha text-lg md:text-xl font-medium mt-4">
          {lang === 'ar' ? 'أكثر من 50 صنفاً من الحلويات المتميزة المصممة لتوزيع السوبرماركت ومستوردي الجملة وطلبات التغليف المخصص OEM.' :
           lang === 'ru' ? 'Более 50 видов сладостей, оптимизированных для международных супермаркетов, оптовиков и брендов (OEM).' :
           lang === 'fr' ? 'Plus de 50 variétés de confiseries adaptées à la grande distribution, aux grossistes et aux projets OEM personnalisés.' :
           'Over 50+ confectionery varieties optimized for international supermarket distribution, importer wholesale, and custom OEM packaging.'}
        </p>
      </div>

      <!-- ── 4 CATEGORY HERO BIG CARDS ── -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-20">
        {categories.map((cat) => (
          <a
            href={translatePath(`/category/${cat.id}`)}
            class={`group relative bg-white rounded-[2.5rem] p-7 border border-choco/5 shadow-[0_15px_35px_rgba(61,44,35,0.05)] hover:shadow-[0_25px_50px_rgba(255,107,157,0.18)] transition-all duration-500 hover:-translate-y-2 flex flex-col justify-between overflow-hidden cursor-pointer ${cat.border}`}
          >
            {/* Luminous Glow Ambient */}
            <div class={`absolute top-0 right-0 rtl:right-auto rtl:left-0 w-44 h-44 bg-gradient-to-bl ${cat.glow} rounded-full blur-2xl group-hover:scale-150 transition-transform duration-700 pointer-events-none`} />

            <div>
              <div class="flex items-center justify-between mb-4">
                <span class={`text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-full ${cat.accent} border border-black/5`}>
                  {cat.countText}
                </span>
                <span class="text-xs font-bold text-strawberry opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1">
                  {lang === 'ar' ? 'استكشف ←' : lang === 'ru' ? 'Смотреть →' : lang === 'fr' ? 'Voir →' : 'Explore →'}
                </span>
              </div>

              {/* Large Floating Hero Illustration */}
              <div class="w-28 h-28 mx-auto my-4 relative group-hover:scale-115 group-hover:rotate-6 transition-transform duration-500">
                <img
                  src={cat.img}
                  alt={cat.name}
                  class="w-full h-full object-contain filter drop-shadow-[0_10px_20px_rgba(0,0,0,0.12)]"
                  loading="lazy"
                />
              </div>

              <h3 class="text-2xl font-black font-display text-choco text-center mb-1 group-hover:text-strawberry transition-colors">
                {cat.catalogName}
              </h3>
              <p class="text-xs font-bold text-strawberry uppercase tracking-wider text-center">
                {cat.tagline}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-choco/5 flex items-center justify-center">
              <span class="text-xs font-bold text-choco/70 group-hover:text-strawberry transition-colors">
                {lang === 'ar' ? 'تصفح القسم ←' : lang === 'ru' ? 'Перейти в раздел →' : lang === 'fr' ? 'Parcourir la gamme →' : 'Browse Category →'}
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-16" id="filter-tabs">
        {filterTabs.map((tab, idx) => (
          <button
            data-filter={tab.id}
            class={`filter-btn px-6 py-3 rounded-full text-sm font-bold font-display tracking-wide transition-all duration-300 shadow-sm cursor-pointer ${
              idx === 0
                ? 'active bg-strawberry text-white shadow-strawberry/20 shadow-md'
                : 'bg-white text-choco hover:bg-strawberry/10 border border-choco/5'
            }`}
          >
            {tab.name}
          </button>
        ))}
      </div>

      <!-- Product Cards Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8" id="products-grid">
        {mockProducts.map((product) => (
          <div
            data-category={product.categoryId}
            class="product-item group flex flex-col bg-white rounded-[2rem] border border-choco/5 shadow-[0_10px_30px_rgba(61,44,35,0.04)] hover:shadow-[0_20px_45px_rgba(255,107,157,0.18)] hover:-translate-y-2 transition-all duration-300 overflow-hidden"
          >
            <a href={translatePath(`/product/${product.id}`)} class="flex flex-col flex-1">
              <!-- Image Container -->
              <div class="relative aspect-square w-full bg-gradient-to-b from-[#FFF8F8] to-white p-6 flex items-center justify-center overflow-hidden">
                <img
                  src={product.image}
                  alt={product.name}
                  class="w-full h-full object-contain filter drop-shadow-md group-hover:scale-110 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute top-4 left-4 rtl:left-auto rtl:right-4">
                  <span class="inline-block px-3 py-1 rounded-full text-[11px] font-black uppercase tracking-wider bg-white/90 backdrop-blur-md text-strawberry border border-strawberry/10 shadow-sm">
                    {categoryNamesMap[product.categoryId] || product.categoryId}
                  </span>
                </div>
              </div>

              <!-- Content -->
              <div class="flex flex-col flex-1 p-5 justify-between bg-white">
                <div>
                  <h3 class="text-base sm:text-lg font-bold font-display text-choco group-hover:text-strawberry transition-colors line-clamp-2 leading-snug">
                    {product.name}
                  </h3>
                </div>

                <div class="mt-4 pt-3 border-t border-choco/5 flex flex-wrap items-center justify-between gap-2 text-xs font-semibold text-mocha">
                  <span class="inline-flex items-center gap-1">
                    ⚖️ {product.weight || '35g'}
                  </span>
                  <span class="inline-flex items-center gap-1 text-mocha/70">
                    📦 {product.packaging || 'Box'}
                  </span>
                </div>
              </div>
            </a>

            <!-- Quick Action Bar -->
            <div class="px-5 pb-5 pt-0 bg-white">
              <a
                href={translatePath(`/product/${product.id}`)}
                class="w-full py-2.5 rounded-full bg-cream hover:bg-strawberry hover:text-white text-choco font-bold text-xs flex items-center justify-center gap-1 transition-colors"
              >
                {lang === 'ar' ? 'عرض المواصفات ←' : lang === 'ru' ? 'Спецификация →' : lang === 'fr' ? 'Spécifications →' : 'View Specifications →'}
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>

  <script>
    function setupFilters() {
      const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
      const items = document.querySelectorAll<HTMLElement>('.product-item');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.dataset.filter;

          buttons.forEach((b) => {
            b.classList.remove('active', 'bg-strawberry', 'text-white', 'shadow-strawberry/20', 'shadow-md');
            b.classList.add('bg-white', 'text-choco', 'border', 'border-choco/5');
          });

          btn.classList.remove('bg-white', 'text-choco', 'border', 'border-choco/5');
          btn.classList.add('active', 'bg-strawberry', 'text-white', 'shadow-strawberry/20', 'shadow-md');

          items.forEach((item) => {
            const cat = item.dataset.category;
            if (filter === 'all' || cat === filter) {
              item.style.display = 'flex';
            } else {
              item.style.display = 'none';
            }
          });
        });
      });
    }

    setupFilters();
    document.addEventListener('astro:page-load', setupFilters);
  </script>
</Layout>
