---
import Layout from '../../layouts/Layout.astro';
import ContactContent from '../ContactContent';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const pageTitle = lang === 'ar' ? 'اتصل بنا — حلويات هولون | استفسارات الجملة والتصدير' :
                  lang === 'ru' ? 'Контакты — Hulun Sweets | Оптовые поставки и экспорт' :
                  lang === 'fr' ? 'Contactez-nous — Hulun Sweets | Devis et commandes en gros' :
                  'Contact Us — Hulun Sweets | Wholesale Inquiries & Export';

const pageDesc = lang === 'ar' ? 'تواصل مع فريق مبيعات حلويات هولون في إيوو، الصين. استفسر عن أسعار الحاويات وتصنيع OEM وعينات الحلويات.' :
                 lang === 'ru' ? 'Свяжитесь с отделом экспорта Hulun Sweets в Иу, Китай. Расчет контейнерных партий, OEM-производство и образцы.' :
                 lang === 'fr' ? 'Contactez l’équipe commerciale de Hulun Sweets à Yiwu, Chine. Demandez des échantillons, devis conteneurs et fabrication OEM.' :
                 'Get in touch with the Hulun Sweets sales team in Yiwu, China. Inquire about container pricing, OEM customization, and free sample kits.';
---

<Layout
  title={pageTitle}
  description={pageDesc}
  lang={lang}
>
  <!-- Restored 100% Original TanStack Interactive Contact Form & Floating Apple Cards -->
  <ContactContent client:load currentLang={lang} />
</Layout>
