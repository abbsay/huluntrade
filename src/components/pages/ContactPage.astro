---
import Layout from '../../layouts/Layout.astro';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const CONTACT_METHODS_DATA: Record<string, Array<{ icon: string; title: string; desc: string; value: string; link: string }>> = {
  en: [
    {
      icon: '📱',
      title: 'Direct Phone & WhatsApp',
      desc: 'Available 7 days a week for fast quotation and catalog sharing.',
      value: '+86 13967427888 / 17758069907',
      link: 'https://wa.me/8613967427888'
    },
    {
      icon: '✉️',
      title: 'Official Export Email',
      desc: 'Send your purchase orders and OEM inquiry specifications.',
      value: 'Van001@huluntrade.com',
      link: 'mailto:Van001@huluntrade.com'
    },
    {
      icon: '📍',
      title: 'Export Office & Showroom',
      desc: 'Located in the heart of the world largest commodity trading center.',
      value: 'Yiwu International Trade City, Zhejiang, China',
      link: 'https://maps.google.com/?q=Yiwu,Zhejiang,China'
    }
  ],
  ar: [
    {
      icon: '📱',
      title: 'هاتف وواتساب مباشر',
      desc: 'متاحون 7 أيام في الأسبوع لعروض الأسعار السريعة ومشاركة الكتالوجات.',
      value: '+86 13967427888 / 17758069907',
      link: 'https://wa.me/8613967427888'
    },
    {
      icon: '✉️',
      title: 'البريد الإلكتروني الرسمي للتصدير',
      desc: 'أرسل أوامر الشراء ومواصفات استفسارات تصنيع OEM.',
      value: 'Van001@huluntrade.com',
      link: 'mailto:Van001@huluntrade.com'
    },
    {
      icon: '📍',
      title: 'مكتب التصدير والمعرض',
      desc: 'في قلب أكبر مركز لتجارة السلع في العالم بمدينة إيوو.',
      value: 'مدينة التجارة الدولية في إيوو، مقاطعة تشجيانغ، الصين',
      link: 'https://maps.google.com/?q=Yiwu,Zhejiang,China'
    }
  ],
  ru: [
    {
      icon: '📱',
      title: 'Телефон и WhatsApp',
      desc: 'На связи без выходных для быстрого расчета цен и отправки каталога.',
      value: '+86 13967427888 / 17758069907',
      link: 'https://wa.me/8613967427888'
    },
    {
      icon: '✉️',
      title: 'Официальный отдел экспорта',
      desc: 'Отправляйте ваши заявки на поставку и спецификации OEM.',
      value: 'Van001@huluntrade.com',
      link: 'mailto:Van001@huluntrade.com'
    },
    {
      icon: '📍',
      title: 'Офис и шоурум фабрики',
      desc: 'В самом центре крупнейшего оптового торгового хаба мира.',
      value: 'Международный торговый город Иу, Чжэцзян, Китай',
      link: 'https://maps.google.com/?q=Yiwu,Zhejiang,China'
    }
  ],
  fr: [
    {
      icon: '📱',
      title: 'Téléphone & WhatsApp Direct',
      desc: 'Disponible 7j/7 pour un devis rapide et la transmission du catalogue.',
      value: '+86 13967427888 / 17758069907',
      link: 'https://wa.me/8613967427888'
    },
    {
      icon: '✉️',
      title: 'E-mail Officiel Export',
      desc: 'Envoyez vos bons de commande et demandes de fabrication OEM.',
      value: 'Van001@huluntrade.com',
      link: 'mailto:Van001@huluntrade.com'
    },
    {
      icon: '📍',
      title: 'Bureau Export & Showroom',
      desc: 'Situé au cœur du plus grand pôle de négoce international.',
      value: 'Cité du Commerce International de Yiwu, Zhejiang, Chine',
      link: 'https://maps.google.com/?q=Yiwu,Zhejiang,China'
    }
  ]
};

const contactMethods = CONTACT_METHODS_DATA[lang] || CONTACT_METHODS_DATA['en'];

const pageTitle = lang === 'ar' ? 'اتصل بنا — حلويات هولون | استفسار عن الحلويات بالجملة و OEM' :
                  lang === 'ru' ? 'Контакты — Hulun Sweets | Оптовые поставки и OEM заказы' :
                  lang === 'fr' ? 'Contactez-nous — Hulun Sweets | Confiserie en gros et fabrication OEM' :
                  'Contact Us — Hulun Sweets | Wholesale Confectionery & OEM Inquiry';

const pageDesc = lang === 'ar' ? 'تواصل مع قسم التصدير في حلويات هولون. اطلب كتالوجات المارشميلو والجيلي والحلويات الصلبة بالجملة وأسعار الحاويات أو شراكات العلامات الخاصة OEM.' :
                 lang === 'ru' ? 'Свяжитесь с отделом экспорта Hulun Sweets. Запросите оптовые каталоги маршмеллоу и мармелада, расчет цен на контейнеры или OEM производство.' :
                 lang === 'fr' ? 'Contactez le service export de Hulun Sweets. Demandez nos catalogues de guimauves et gélifiés en gros, nos tarifs conteneurs ou partenariats OEM.' :
                 'Contact Hulun Sweets export department. Inquire for wholesale marshmallow, jelly, and hard candy catalogs, container pricing, or OEM private label partnerships.';
---

<Layout
  title={pageTitle}
  description={pageDesc}
  lang={lang}
>
  <div class="pt-36 lg:pt-44 pb-32 bg-cream min-h-screen">
    <div class="max-w-[1300px] mx-auto px-4 md:px-6 xl:px-8">

      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest bg-strawberry/10 text-strawberry mb-4 border border-strawberry/20">
          {lang === 'ar' ? 'تواصل معنا' : lang === 'ru' ? 'Связаться с нами' : lang === 'fr' ? 'Contactez-nous' : 'Get in Touch'}
        </span>
        <h1 class="text-4xl md:text-6xl font-black font-display text-choco tracking-tight">
          {lang === 'ar' ? 'لنبدأ تعاوناً حلواً ومثمراً معاً' :
           lang === 'ru' ? 'Давайте начнем сладкое и надежное сотрудничество' :
           lang === 'fr' ? 'Créons ensemble un partenariat gourmand et durable' :
           'Let\'s Start Something Sweet Together'}
        </h1>
        <p class="text-mocha text-lg md:text-xl font-medium mt-4">
          {lang === 'ar' ? 'سواء كنت مستورداً دولياً، أو موزعاً، أو صاحب علامة تجارية تبحث عن تصنيع حلوى OEM، فريق مبيعاتنا مستعد لخدمتك.' :
           lang === 'ru' ? 'Если вы международный импортер, оптовый дистрибьютор или владелец бренда, ищущий надежного OEM производителя, мы готовы помочь.' :
           lang === 'fr' ? 'Que vous soyez importateur, distributeur ou marque à la recherche d’une fabrication de confiserie OEM, notre équipe est à votre disposition.' :
           'Whether you are an overseas importer, distributor, or brand owner seeking OEM candy manufacturing, our sales representatives are ready to assist.'}
        </p>
      </div>

      <!-- Quick Contact Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        {contactMethods.map((method) => (
          <a
            href={method.link}
            target={method.link.startsWith('http') ? '_blank' : undefined}
            rel={method.link.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="group bg-white p-8 rounded-[2rem] border border-choco/5 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between"
          >
            <div>
              <div class="text-4xl mb-4 group-hover:scale-110 transition-transform origin-left rtl:origin-right">{method.icon}</div>
              <h3 class="text-xl font-bold font-display text-choco mb-2 group-hover:text-strawberry transition-colors">
                {method.title}
              </h3>
              <p class="text-sm text-mocha/80 leading-relaxed mb-6 font-medium">
                {method.desc}
              </p>
            </div>
            <div class="pt-4 border-t border-choco/5 text-sm font-bold text-choco group-hover:text-strawberry transition-colors truncate">
              {method.value} &rarr;
            </div>
          </a>
        ))}
      </div>

      <!-- Inquiry Form Container -->
      <div class="bg-white rounded-[2.5rem] p-8 sm:p-12 lg:p-16 border border-choco/5 shadow-md max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-black font-display text-choco tracking-tight">
            {lang === 'ar' ? 'إرسال استفسار تصدير' : lang === 'ru' ? 'Отправить экспортный запрос' : lang === 'fr' ? 'Envoyer une demande d’exportation' : 'Send an Export Inquiry'}
          </h2>
          <p class="text-mocha text-sm sm:text-base mt-2 font-medium">
            {lang === 'ar' ? 'املأ النموذج أدناه وسيقوم فريقنا بالرد عليك بكتالوجات الجملة وعروض الأسعار في غضون 24 ساعة.' :
             lang === 'ru' ? 'Заполните форму ниже, и мы отправим вам оптовые каталоги и расчет цен в течение 24 часов.' :
             lang === 'fr' ? 'Remplissez le formulaire ci-dessous et nous vous répondrons avec catalogues et tarifs sous 24 heures.' :
             'Fill out the form below and we will get back to you with wholesale catalogs and pricing within 24 hours.'}
          </p>
        </div>

        <form id="inquiry-form" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-xs font-bold uppercase tracking-wider text-choco mb-2">
                {lang === 'ar' ? 'الاسم الكريم *' : lang === 'ru' ? 'Ваше имя *' : lang === 'fr' ? 'Votre Nom *' : 'Your Name *'}
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder={lang === 'ar' ? 'مثال: محمد أحمد' : lang === 'ru' ? 'Например: Иван Иванов' : lang === 'fr' ? 'Ex: Jean Dupont' : 'e.g. John Doe'}
                class="w-full px-5 py-3.5 rounded-2xl bg-cream/50 border border-choco/10 text-choco placeholder:text-mocha/40 focus:outline-none focus:border-strawberry focus:ring-2 focus:ring-strawberry/20 text-sm font-medium transition-all"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-bold uppercase tracking-wider text-choco mb-2">
                {lang === 'ar' ? 'البريد الإلكتروني *' : lang === 'ru' ? 'Электронная почта *' : lang === 'fr' ? 'Adresse E-mail *' : 'Email Address *'}
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="buyer@company.com"
                class="w-full px-5 py-3.5 rounded-2xl bg-cream/50 border border-choco/10 text-choco placeholder:text-mocha/40 focus:outline-none focus:border-strawberry focus:ring-2 focus:ring-strawberry/20 text-sm font-medium transition-all"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-choco mb-2">
                {lang === 'ar' ? 'رقم الهاتف / واتساب' : lang === 'ru' ? 'Телефон / WhatsApp' : lang === 'fr' ? 'Téléphone / WhatsApp' : 'WhatsApp / Phone Number'}
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="+966 50 123 4567"
                class="w-full px-5 py-3.5 rounded-2xl bg-cream/50 border border-choco/10 text-choco placeholder:text-mocha/40 focus:outline-none focus:border-strawberry focus:ring-2 focus:ring-strawberry/20 text-sm font-medium transition-all"
              />
            </div>

            <div>
              <label for="country" class="block text-xs font-bold uppercase tracking-wider text-choco mb-2">
                {lang === 'ar' ? 'الدولة / المنطقة المستهدفة' : lang === 'ru' ? 'Страна / Регион назначения' : lang === 'fr' ? 'Pays / Région de destination' : 'Target Country / Region'}
              </label>
              <input
                type="text"
                id="country"
                name="country"
                placeholder={lang === 'ar' ? 'مثال: السعودية، الإمارات، مصر' : lang === 'ru' ? 'Например: Россия, Казахстан, ОАЭ' : lang === 'fr' ? 'Ex: France, Algérie, Maroc' : 'e.g. Saudi Arabia, UAE, Russia'}
                class="w-full px-5 py-3.5 rounded-2xl bg-cream/50 border border-choco/10 text-choco placeholder:text-mocha/40 focus:outline-none focus:border-strawberry focus:ring-2 focus:ring-strawberry/20 text-sm font-medium transition-all"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-xs font-bold uppercase tracking-wider text-choco mb-2">
              {lang === 'ar' ? 'المنتج أو الخدمة المطلوبة' : lang === 'ru' ? 'Интересующий продукт / услуга' : lang === 'fr' ? 'Produit ou service d’intérêt' : 'Interested Product / Service'}
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder={lang === 'ar' ? 'مثال: طلب حاوية مارشميلو، تصنيع علامة خاصة OEM' : lang === 'ru' ? 'Например: Контейнер маршмеллоу, контрактное производство OEM' : lang === 'fr' ? 'Ex: Commande conteneur guimauve, marque blanche OEM' : 'e.g. Marshmallow Bulk Order, OEM Custom Label, Wholesale Catalog'}
              class="w-full px-5 py-3.5 rounded-2xl bg-cream/50 border border-choco/10 text-choco placeholder:text-mocha/40 focus:outline-none focus:border-strawberry focus:ring-2 focus:ring-strawberry/20 text-sm font-medium transition-all"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-bold uppercase tracking-wider text-choco mb-2">
              {lang === 'ar' ? 'تفاصيل الاستفسار / الكمية التقديرية *' : lang === 'ru' ? 'Детали запроса / ориентировочный объем *' : lang === 'fr' ? 'Détails de la demande / Quantités estimées *' : 'Inquiry Details / Estimated Volume *'}
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder={lang === 'ar' ? 'يرجى إعلامنا بمتطلباتك، ميناء الوصول، الكميات المقدرة، أو متطلبات التغليف المخصصة...' :
                           lang === 'ru' ? 'Укажите ваши требования, порт назначения, желаемые объемы или пожелания по упаковке...' :
                           lang === 'fr' ? 'Veuillez préciser vos besoins, port de destination, volumes estimés ou emballages spécifiques...' :
                           'Please let us know your requirements, target port, estimated quantities, or custom packaging needs...'}
              class="w-full px-5 py-3.5 rounded-2xl bg-cream/50 border border-choco/10 text-choco placeholder:text-mocha/40 focus:outline-none focus:border-strawberry focus:ring-2 focus:ring-strawberry/20 text-sm font-medium transition-all resize-y"
            ></textarea>
          </div>

          <div id="form-feedback" class="hidden p-4 rounded-2xl text-center text-sm font-bold"></div>

          <div class="text-center pt-2">
            <button
              type="submit"
              id="submit-btn"
              class="w-full sm:w-auto px-10 py-4 rounded-full bg-strawberry hover:bg-pink-600 text-white font-bold font-display tracking-wide shadow-lg shadow-strawberry/30 hover:scale-105 transition-all text-base cursor-pointer"
            >
              {lang === 'ar' ? 'إرسال رسالة الاستفسار ←' : lang === 'ru' ? 'Отправить запрос →' : lang === 'fr' ? 'Envoyer la demande →' : 'Send Inquiry Message →'}
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>

  <script>
    function setupContactForm() {
      const urlParams = new URLSearchParams(window.location.search);
      const subj = urlParams.get('subject');
      const subjectInput = document.getElementById('subject') as HTMLInputElement;
      if (subj && subjectInput) {
        subjectInput.value = subj;
      }

      const form = document.getElementById('inquiry-form') as HTMLFormElement;
      const feedback = document.getElementById('form-feedback') as HTMLDivElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

      if (!form) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.innerText = 'Submitting...';

        const name = (document.getElementById('name') as HTMLInputElement).value;
        const email = (document.getElementById('email') as HTMLInputElement).value;
        const phone = (document.getElementById('phone') as HTMLInputElement).value;
        const subject = subjectInput ? subjectInput.value : '';
        const message = (document.getElementById('message') as HTMLTextAreaElement).value;

        const mailSubject = encodeURIComponent(`[Website Inquiry] ${subject || 'New Candy Inquiry'}`);
        const mailBody = encodeURIComponent(
          `Name: ${name}\nEmail: ${email}\nPhone: ${phone}\n\nMessage:\n${message}`
        );

        feedback.className = 'p-4 rounded-2xl text-center text-sm font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 block';
        feedback.innerText = 'Thank you! Preparing your direct inquiry mail draft...';

        setTimeout(() => {
          window.location.href = `mailto:Van001@huluntrade.com?subject=${mailSubject}&body=${mailBody}`;
          submitBtn.disabled = false;
          submitBtn.innerText = 'Send Inquiry Message →';
        }, 600);
      });
    }

    setupContactForm();
    document.addEventListener('astro:page-load', setupContactForm);
  </script>
</Layout>
