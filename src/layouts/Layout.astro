---
import '../index.css';
import { Header } from '../components/layout/Header';
import { Footer } from '../components/layout/Footer';
import { ClientRouter } from 'astro:transitions';
import { isRTL, SUPPORTED_LANGS, DEFAULT_LANG } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: string;
}

const {
  title = "Hulun Sweets — Sweet Joy, Global Flavors | Wholesale Candy & Confectionery",
  description = "Hulun Sweets is a premier candy & confectionery manufacturer and exporter based in Yiwu, China. Specializing in fluffy marshmallows, fruit jellies, handmade hard candies, and playful candy toys.",
  image = "/logo.png",
  lang = DEFAULT_LANG,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://huluntrade.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

// Calculate base route path without locale prefix for hreflang
const pathname = Astro.url.pathname;
const segments = pathname.split('/').filter(Boolean);
let basePath = pathname;
if (segments.length > 0 && (SUPPORTED_LANGS as readonly string[]).includes(segments[0])) {
  basePath = '/' + segments.slice(1).join('/');
  if (basePath === '') basePath = '/';
}

const getLocaleUrl = (l: string) => {
  const cleanBase = basePath === '/' ? '' : basePath;
  return l === DEFAULT_LANG ? `${siteUrl}${cleanBase || '/'}` : `${siteUrl}/${l}${cleanBase}`;
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Hulun Sweets",
  "url": "https://huluntrade.com",
  "logo": "https://huluntrade.com/logo.png",
  "description": "Premier candy & confectionery manufacturer and exporter based in Yiwu, China.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Yiwu",
    "addressRegion": "Zhejiang",
    "addressCountry": "CN"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+86-13967427888",
    "contactType": "sales",
    "availableLanguage": ["en", "ar", "ru", "fr", "zh"]
  }
};
---

<!doctype html>
<html lang={lang} dir={isRTL(lang) ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/images/categories/minimal_marshmallow.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Multilingual Hreflang Tags for SEO / International Indexing -->
    {SUPPORTED_LANGS.map((locale) => (
      <link rel="alternate" hreflang={locale} href={getLocaleUrl(locale)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={getLocaleUrl(DEFAULT_LANG)} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Schema.org Organization JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />

    <!-- Google Fonts: Quicksand (Body), Baloo 2 (Playful Titles), Noto Sans Arabic (RTL) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Noto+Sans+Arabic:wght@400;500;600&family=Noto+Sans:wght@400;500;600&family=Quicksand:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Astro View Transitions for instant seamless navigation -->
    <ClientRouter />
  </head>
  <body class="antialiased min-h-screen flex flex-col bg-cream text-choco font-sans selection:bg-strawberry selection:text-white">
    <Header client:load currentLang={lang} />

    <main class="flex-grow w-full z-0">
      <slot />
    </main>

    <Footer client:visible currentLang={lang} />
  </body>
</html>
